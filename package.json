{
  "name": "obsidian-local-rest-api",
  "version": "5.1.0",
  "description": "A secure REST API and Model Context Protocol (MCP) server for Obsidian.",
  "main": "publicApi.js",
  "types": "publicApi.d.ts",
  "files": [
    "publicApi.js",
    "publicApi.d.ts",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production && npm run build-types",
    "build-types": "tsc -p tsconfig.types.json",
    "typecheck": "node --max-old-space-size=6144 node_modules/.bin/tsc -noEmit -skipLibCheck",
    "build-docs": "node scripts/gen-patch-schema.mjs && jsonnet -J docs/src/lib/ -S docs/src/openapi.jsonnet -o docs/openapi.yaml",
    "serve-docs": "npx serve docs",
    "build-toc": "markdown-toc -i README.md",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint src/",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.13",
    "@types/glob-to-regexp": "^0.4.1",
    "@types/jest": "^29",
    "@types/mime-types": "^2.1.1",
    "@types/node": "^18",
    "@types/node-forge": "^1.0.0",
    "@types/response-time": "^2.3.9",
    "@types/supertest": "^2.0.11",
    "cors": "^2.8.5",
    "esbuild": "0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "express": "^4.21.1",
    "glob-to-regexp": "^0.4.1",
    "jest": "^29",
    "json-logic-js": "^2.0.2",
    "markdown-patch": "^1.1.0",
    "markdown-patch-2": "npm:markdown-patch@^2.0.0",
    "markdown-toc": "^1.2.0",
    "mime-types": "^2.1.35",
    "node-forge": "^1.2.1",
    "obsidian": "^1.13.1",
    "query-string": "^7.1.1",
    "response-time": "^2.3.2",
    "supertest": "^6.2.2",
    "ts-dedent": "^2.3.0",
    "ts-jest": "^29",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "zod": "3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  },
  "peerDependencies": {
    "@types/express": "^4.17.13",
    "obsidian": "^1.0.0",
    "zod": "^3.25.76"
  }
}
